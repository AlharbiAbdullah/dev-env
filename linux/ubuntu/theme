#!/usr/bin/env bash
# shellcheck shell=bash
# Unified theme switcher: Ghostty, Hyprland borders, VS Code, Cursor, Chrome,
# Starship prompt, swaybg wallpaper, waybar.
# Obsidian is intentionally NOT themed — it stays pinned to "Obsidian Nord".
#
# Usage:
#   theme                         list available themes + current
#   theme <name>                  activate theme
#   theme reload                  re-apply current (used by hyprland on startup)
#   theme cycle                   switch to the next theme in list
#   theme menu                    rofi popup picker (Spotlight-style)
#   theme pick                    fzf picker with live preview
#   theme wallpaper [next|prev|random|menu]
#                                 rotate wallpaper within current theme
#                                 (menu = rofi thumbnail-grid picker)

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
CACHE_DIR="$HOME/.cache/theme"
STARSHIP_CONFIG="$HOME/.config/starship.toml"
VSCODE_SETTINGS="$HOME/.config/Code/User/settings.json"
CURSOR_SETTINGS="$HOME/.config/Cursor/User/settings.json"

mkdir -p "$CACHE_DIR"

SELF="$HOME/.local/bin/theme"

hud() {
  local msg="$1" duration="${2:-2}"
  command -v notify-send >/dev/null || return 0
  notify-send -t $((duration * 1000)) "$msg" >/dev/null 2>&1 || true
}

# -----------------------------------------------------------------------------
# helpers
# -----------------------------------------------------------------------------

list_themes() {
  for d in "$THEMES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    [[ -f "$d/theme.lua" ]] || continue
    basename "$d"
  done
}

current_theme() {
  if [[ -L "$THEMES_DIR/current.lua" ]]; then
    local target
    target=$(readlink "$THEMES_DIR/current.lua")
    basename "$(dirname "$target")"
  fi
}

theme_wallpapers() {
  local theme="$1"
  find "$THEMES_DIR/$theme/wallpapers" -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null | sort
}

set_wallpaper_on_disk() {
  local wp="$1" theme="$2"
  [[ -z "$wp" || ! -f "$wp" ]] && return 0
  echo "$wp" > "$CACHE_DIR/$theme.wallpaper"
  pkill -x swaybg 2>/dev/null || true
  (swaybg -m fill -i "$wp" >/dev/null 2>&1 &) && disown 2>/dev/null || true
}

update_starship_palette() {
  local palette="$1"
  [[ -f "$STARSHIP_CONFIG" ]] || return 0
  if grep -qE '^palette\s*=' "$STARSHIP_CONFIG"; then
    sed -i -E "s|^palette[[:space:]]*=.*|palette = \"$palette\"|" "$STARSHIP_CONFIG"
  fi
}

update_vscode_settings() {
  local path="$1" theme="$2" ext="${3:-}"
  [[ -z "$theme" ]] && return 0
  # Auto-install the theme's extension if missing (Omarchy parity). A wrong/
  # uninstalled colorTheme name makes VS Code silently fall back to its default.
  # `code` on PATH is Cursor now; target real VS Code explicitly for ext installs.
  if [[ -n "$ext" && -x /usr/bin/code ]]; then
    if ! /usr/bin/code --list-extensions 2>/dev/null | grep -Fxq "$ext"; then
      /usr/bin/code --install-extension "$ext" >/dev/null 2>&1 || true
    fi
  fi
  [[ ! -f "$path" ]] && return 0
  python3 - "$path" "$theme" <<'PY'
import re, sys
path, theme = sys.argv[1], sys.argv[2]
c = open(path).read()
pat = r'("workbench\.colorTheme"\s*:\s*)"[^"]*"'
if re.search(pat, c):
    c = re.sub(pat, r'\1"' + theme + '"', c, count=1)
else:
    c = re.sub(r'\{', '{\n  "workbench.colorTheme": "' + theme + '",', c, count=1)
open(path, 'w').write(c)
PY
}

update_waybar_colors() {
  local src="$1" border="$2"
  local waybar_dir="$HOME/.config/waybar"
  [[ -d "$waybar_dir" ]] || return 0
  local bg fg accent
  bg=$(grep -E '^[[:space:]]*background[[:space:]]*=' "$src" | head -1 | sed -E 's/.*"([^"]*)".*/\1/')
  fg=$(grep -E '^[[:space:]]*foreground[[:space:]]*=' "$src" | head -1 | sed -E 's/.*"([^"]*)".*/\1/')
  [[ -z "$bg" || -z "$fg" ]] && return 0
  accent="#${border: -6}"
  # ansi order: black red green yellow blue magenta cyan white
  local -a ansi=()
  while IFS= read -r c; do ansi+=("$c"); done \
    < <(grep -A1 'ansi = {' "$src" | grep -oE '#[0-9a-fA-F]{6}')
  cat > "$waybar_dir/theme-colors.css" <<EOF
/* generated by ~/.local/bin/theme — edit the theme.lua, not this file */
@define-color background $bg;
@define-color foreground $fg;
@define-color accent $accent;
@define-color red ${ansi[1]:-$fg};
@define-color green ${ansi[2]:-$fg};
@define-color yellow ${ansi[3]:-$fg};
EOF
  pkill -SIGUSR2 -x waybar 2>/dev/null || true
}

update_ghostty_colors() {
  # Ghostty can't read the theme's Lua directly (WezTerm did), so translate the
  # palette into a Ghostty include file and signal a live reload (SIGUSR2).
  local src="$1"
  local ghostty_dir="$HOME/.config/ghostty"
  [[ -d "$ghostty_dir" ]] || return 0
  python3 - "$src" "$ghostty_dir/theme.conf" <<'PY'
import re, sys
src, out = sys.argv[1], sys.argv[2]
t = open(src).read()
def field(name):
    m = re.search(r'\b' + name + r'\s*=\s*"([^"]+)"', t)
    return m.group(1) if m else None
def arr(name):
    m = re.search(r'\b' + name + r'\s*=\s*\{(.*?)\}', t, re.S)
    return re.findall(r'#[0-9a-fA-F]{6}', m.group(1)) if m else []
fields = [
    ('background',           field('background')),
    ('foreground',           field('foreground')),
    ('cursor-color',         field('cursor_bg')),
    ('cursor-text',          field('cursor_fg')),
    ('selection-background', field('selection_bg')),
    ('selection-foreground', field('selection_fg')),
]
pal = arr('ansi') + arr('brights')
lines = ['# generated by ~/.local/bin/theme — edit the theme.lua, not this file']
lines += [f'{k} = {v}' for k, v in fields if v]
lines += [f'palette = {i}={c}' for i, c in enumerate(pal[:16])]
open(out, 'w').write('\n'.join(lines) + '\n')
PY
  pkill -USR2 -x ghostty 2>/dev/null || true
}

update_tmux_colors() {
  # Same shape as Ghostty: tmux can't read the theme's Lua, so translate the
  # palette into a generated include (`~/.config/tmux/theme.conf`, sourced by
  # ~/.tmux.conf) and live-reload the running server — `tmux source-file` is the
  # SIGUSR2 analog (no restart, panes preserved). Coherent-minimal styling:
  # recolor the status bar + borders + active window, keep tmux's default layout.
  local src="$1" border="$2"
  command -v tmux >/dev/null 2>&1 || return 0
  local tmux_dir="$HOME/.config/tmux"
  mkdir -p "$tmux_dir"
  local accent="#${border: -6}"
  python3 - "$src" "$tmux_dir/theme.conf" "$accent" <<'PY'
import re, sys
src, out, accent = sys.argv[1], sys.argv[2], sys.argv[3]
t = open(src).read()
def field(name):
    m = re.search(r'\b' + name + r'\s*=\s*"([^"]+)"', t)
    return m.group(1) if m else None
def arr(name):
    m = re.search(r'\b' + name + r'\s*=\s*\{(.*?)\}', t, re.S)
    return re.findall(r'#[0-9a-fA-F]{6}', m.group(1)) if m else []
base   = field('background')   or '#1c2027'   # bar = terminal bg, so pills float
text   = field('foreground')   or '#d3c6aa'
sel_bg = field('selection_bg') or text
sel_fg = field('selection_fg') or base
ansi    = arr('ansi')
surface = ansi[0] if len(ansi) > 0 else base   # ansi "black" = dim border
info    = ansi[4] if len(ansi) > 4 else accent  # theme's blue → session + clock pills
lb, rb = '', ''                     # rounded powerline caps
# Two theme colors: accent (signature) marks the ACTIVE window — the thing you
# care about; info (blue) frames the session name + clock. Bar itself transparent.
lines = [
    '# generated by ~/.local/bin/theme — edit the theme.lua, not this file',
    'set -g status on',
    'set -g status-interval 30',
    'set -g status-position bottom',
    'set -g status-justify left',
    f'set -g status-style "bg={base},fg={text}"',
    'set -g status-left-length 40',
    'set -g status-right-length 60',
    f'set -g status-left "#[fg={info},bg={base}]{lb}#[fg={base},bg={info},bold] #S #[fg={info},bg={base}]{rb} "',
    f'set -g status-right "#[fg={info},bg={base}]{lb}#[fg={base},bg={info},bold] %H:%M #[fg={info},bg={base}]{rb}"',
    'set -g window-status-separator ""',
    f'set -g window-status-format "#[fg={text},bg={base}]  #I:#W "',
    f'set -g window-status-current-format "#[fg={accent},bg={base}]{lb}#[fg={base},bg={accent},bold] #I:#W #[fg={accent},bg={base}]{rb}"',
    f'set -g pane-active-border-style "fg={accent}"',
    f'set -g pane-border-style "fg={surface}"',
    f'set -g message-style "bg={accent},fg={base}"',
    f'set -g message-command-style "bg={accent},fg={base}"',
    f'set -g mode-style "bg={sel_bg},fg={sel_fg}"',
    f'set -g clock-mode-colour "{accent}"',
]
open(out, 'w', encoding='utf-8').write('\n'.join(lines) + '\n')
PY
  # Live-reload the running server (global options, so source-file applies)
  if tmux ls >/dev/null 2>&1; then
    tmux source-file "$tmux_dir/theme.conf" 2>/dev/null || true
  fi
}

update_chrome_theme() {
  # Theme stock Chrome via the BrowserThemeColor managed policy (Omarchy's
  # mechanism). NOTE: BrowserColorScheme is NOT a real stock-Chrome policy
  # (only Omarchy's patched chromium honors it) — BrowserThemeColor is the only
  # key that works, and Chrome derives its whole UI tint from this one seed.
  # One-time setup (so per-switch writes need no sudo):
  #   sudo mkdir -p /etc/opt/chrome/policies/managed
  #   sudo chmod a+rw   /etc/opt/chrome/policies/managed
  # Frame-only by design (user's choice): BrowserThemeColor tints Chrome's frame;
  # the toolbar stays a neutral surface. The OS light/dark preference (which makes
  # YouTube/Google and other "use device theme" sites follow) is handled separately
  # by update_color_scheme — not here.
  local src="$1"
  local policy_dir="/etc/opt/chrome/policies/managed"
  [[ -d "$policy_dir" && -w "$policy_dir" ]] || return 0

  local bg
  bg=$(grep -E '^[[:space:]]*background[[:space:]]*=' "$src" | head -1 | sed -E 's/.*"([^"]*)".*/\1/')
  [[ "$bg" == \#* ]] || bg="#$bg"
  [[ ${#bg} -eq 7 ]] || bg="#1c2027"   # neutral grey fallback (same as Omarchy)

  printf '{"BrowserThemeColor": "%s"}\n' "$bg" > "$policy_dir/color.json"

  # Live-apply to a running Chrome without restarting it (tabs preserved).
  if pgrep -x chrome >/dev/null 2>&1; then
    local cb
    cb=$(command -v google-chrome-stable || command -v google-chrome || true)
    [[ -n "$cb" ]] && (setsid "$cb" --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &) || true
  fi
}

update_color_scheme() {
  # Drive the OS light/dark preference from the theme's dark/light marker (the
  # `macos` field). The freedesktop portal exposes color-scheme as
  # org.freedesktop.appearance — Chrome/Firefox/Electron and GTK4/libadwaita apps
  # read it, so sites set to "use device theme" (YouTube, Google) follow the theme.
  # gtk-theme additionally flips legacy GTK3 apps. Both are stock keys (no extra
  # packages); Adwaita / Adwaita-dark always exist.
  local mode="$1"   # "dark" | "light"
  command -v gsettings >/dev/null 2>&1 || return 0
  local scheme gtk
  if [[ "$mode" == "light" ]]; then
    scheme="prefer-light"; gtk="Adwaita"
  else
    scheme="prefer-dark";  gtk="Adwaita-dark"
  fi
  gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# apply a theme end-to-end
# -----------------------------------------------------------------------------

apply_theme() {
  local name="$1"
  local theme_dir="$THEMES_DIR/$name"
  local src="$theme_dir/theme.lua"

  if [[ ! -f "$src" ]]; then
    echo "theme not found: $name" >&2
    return 1
  fi

  get_field() {
    # A missing field must yield empty, not crash: under `set -euo pipefail` an
    # unmatched grep exits 1, the pipeline fails, and `var=$(get_field x)` then
    # trips set -e (silent exit). Guard grep so optional fields (e.g. vscode_ext)
    # are simply blank.
    { grep -E "^[[:space:]]*$1[[:space:]]*=" "$src" || true; } | head -1 | sed -E 's/.*"([^"]*)".*/\1/'
  }

  local border vscode_theme vscode_ext cursor_theme mode
  border=$(get_field border)
  vscode_theme=$(get_field vscode)
  vscode_ext=$(get_field vscode_ext)
  cursor_theme=$(get_field cursor)
  mode=$(get_field macos); [[ -z "$mode" ]] && mode="dark"

  ln -sfn "$src" "$THEMES_DIR/current.lua"

  # Hyprland borders (raw 0xAARRGGBB is accepted natively)
  [[ -z "$border" ]] && border="0xffd3869b"
  hyprctl keyword general:col.active_border "$border" >/dev/null 2>&1 || true

  # Ghostty (regenerate theme.conf + live reload via SIGUSR2)
  update_ghostty_colors "$src"

  # tmux (regenerate theme.conf + live source-file on the running server)
  update_tmux_colors "$src" "$border"

  # Starship palette
  update_starship_palette "$name"

  # VS Code (auto-installs the theme extension if missing)
  update_vscode_settings "$VSCODE_SETTINGS" "$vscode_theme" "$vscode_ext"

  # Cursor (generated rai-themes extension; rebuild via `theme regen`)
  update_vscode_settings "$CURSOR_SETTINGS" "$cursor_theme"

  # Chrome (managed-policy seed + live policy refresh — Omarchy's mechanism)
  update_chrome_theme "$src"

  # OS light/dark preference (portal color-scheme) — makes "use device theme"
  # sites (YouTube, Google) and GTK apps follow the theme's dark/light marker
  update_color_scheme "$mode"

  # Waybar (regenerate color vars, SIGUSR2 = style reload)
  update_waybar_colors "$src" "$border"

  # Wallpaper: keep last-used for this theme if possible, else first
  local state_file="$CACHE_DIR/$name.wallpaper"
  local wp=""
  if [[ -f "$state_file" ]]; then
    local saved
    saved=$(cat "$state_file")
    [[ -f "$saved" ]] && wp="$saved"
  fi
  if [[ -z "$wp" ]]; then
    wp=$(theme_wallpapers "$name" | head -1)
  fi
  set_wallpaper_on_disk "$wp" "$name"

  hud "$name"

  echo "theme: $name"
  echo "  border:    $border"
  echo "  vscode:    ${vscode_theme:-(skipped)}"
  echo "  cursor:    ${cursor_theme:-(skipped)}"
  [[ -w /etc/opt/chrome/policies/managed ]] && echo "  chrome:    color.json (seed $(get_field background))"
  echo "  color-scheme: $([[ "$mode" == light ]] && echo prefer-light || echo prefer-dark) ($mode)"
  echo "  waybar:    theme-colors.css"
  echo "  ghostty:   theme.conf"
  echo "  tmux:      theme.conf"
  echo "  wallpaper: ${wp:-(none)}"
}

# -----------------------------------------------------------------------------
# commands
# -----------------------------------------------------------------------------

cmd="${1:-}"

case "$cmd" in
  "")
    current=$(current_theme || true)
    echo "current: ${current:-(none)}"
    echo "available:"
    list_themes | sed 's/^/  /'
    ;;
  reload)
    name=$(current_theme || true)
    [[ -z "$name" ]] && { echo "no current theme" >&2; exit 1; }
    apply_theme "$name"
    ;;
  cycle)
    current=$(current_theme || true)
    themes=()
    while IFS= read -r t; do themes+=("$t"); done < <(list_themes)
    idx=0
    for i in "${!themes[@]}"; do
      [[ "${themes[$i]}" == "$current" ]] && { idx=$i; break; }
    done
    next=$(( (idx + 1) % ${#themes[@]} ))
    apply_theme "${themes[$next]}"
    ;;
  pick)
    original=$(current_theme || true)
    if ! selected=$(list_themes | fzf \
          --prompt "theme> " \
          --height 50% \
          --border rounded \
          --preview "cat '$THEMES_DIR/{}/theme.lua'" \
          --preview-window right:45% \
          --bind "focus:execute-silent($SELF {} >/dev/null 2>&1)"); then
      [[ -n "$original" ]] && "$SELF" "$original" >/dev/null
      exit 0
    fi
    echo "theme: $selected"
    ;;
  menu)
    # rofi popup picker (Spotlight-style — frosted via Hyprland's rofi layerrule).
    # Plain list like the app launcher; cursor starts on the current theme.
    current=$(current_theme || true)
    themes=()
    while IFS= read -r t; do themes+=("$t"); done < <(list_themes)
    idx=0
    for i in "${!themes[@]}"; do
      [[ "${themes[$i]}" == "$current" ]] && { idx=$i; break; }
    done
    sel=$(printf '%s\n' "${themes[@]}" | rofi -dmenu -i \
            -p "theme" \
            -theme "$HOME/.config/rofi/spotlight.rasi" \
            -selected-row "$idx") || exit 0
    [[ -n "$sel" ]] && apply_theme "$sel"
    ;;
  wallpaper)
    action="${2:-next}"
    current=$(current_theme || true)
    [[ -z "$current" ]] && { echo "no active theme" >&2; exit 1; }
    wps=()
    while IFS= read -r w; do wps+=("$w"); done < <(theme_wallpapers "$current")
    if [[ ${#wps[@]} -eq 0 ]]; then
      echo "no wallpapers for theme: $current" >&2
      exit 0
    fi

    state_file="$CACHE_DIR/$current.wallpaper"
    current_wp=""
    [[ -f "$state_file" ]] && current_wp=$(cat "$state_file")

    idx=0
    for i in "${!wps[@]}"; do
      [[ "${wps[$i]}" == "$current_wp" ]] && { idx=$i; break; }
    done

    case "$action" in
      next)   new_idx=$(( (idx + 1) % ${#wps[@]} )) ;;
      prev)   new_idx=$(( (idx - 1 + ${#wps[@]}) % ${#wps[@]} )) ;;
      random) new_idx=$(( RANDOM % ${#wps[@]} )) ;;
      menu)
        # rofi thumbnail grid: each row is "name\0icon\x1f/path" so rofi renders
        # the image itself; vertical elements put the thumbnail above its name.
        sel=$(for w in "${wps[@]}"; do
                printf '%s\0icon\x1f%s\n' "$(basename "$w")" "$w"
              done | rofi -dmenu -i -show-icons \
                -p "wallpaper" \
                -theme "$HOME/.config/rofi/spotlight.rasi" \
                -theme-str 'listview { columns: 3; lines: 2; spacing: 12px; } element { orientation: vertical; } element-icon { size: 180px; } element-text { horizontal-align: 0.5; }' \
                -selected-row "$idx") || exit 0
        [[ -z "$sel" ]] && exit 0
        new_idx=-1
        for i in "${!wps[@]}"; do
          [[ "$(basename "${wps[$i]}")" == "$sel" ]] && { new_idx=$i; break; }
        done
        [[ $new_idx -lt 0 ]] && exit 0
        ;;
      *) echo "usage: theme wallpaper [next|prev|random|menu]" >&2; exit 1 ;;
    esac

    new_wp="${wps[$new_idx]}"
    set_wallpaper_on_disk "$new_wp" "$current"
    wp_name=$(basename "$new_wp")
    hud "$wp_name  ($((new_idx + 1))/${#wps[@]})"
    echo "wallpaper: $wp_name  ($((new_idx + 1))/${#wps[@]})"
    ;;
  regen)
    # Rebuild the rai-themes editor extension from every theme.lua, then re-apply.
    python3 "$THEMES_DIR/build-editor-themes.py"
    name=$(current_theme || true)
    [[ -n "$name" ]] && apply_theme "$name"
    ;;
  *)
    apply_theme "$cmd"
    ;;
esac
