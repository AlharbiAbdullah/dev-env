[Unit]
# Mac-style Super+C/V/X/A/Z in GUI apps. Config + rationale: ~/.config/xremap/config.yml
#
# Started by Hyprland's exec-once, NOT by graphical-session.target: that target
# sits inactive on this machine (fallout from the Chrome Remote Desktop purge on
# 2026-08-01), so anything wired to it would silently never run. Starting from
# exec-once also guarantees HYPRLAND_INSTANCE_SIGNATURE is already in the user
# manager's environment, which xremap's hypr backend needs to read the focused
# window class over Hyprland's IPC.
Description=xremap — Mac-style Super shortcuts for GUI apps
Documentation=https://github.com/xremap/xremap
After=hyprland-session.target

[Service]
Type=simple
# `sg input` supplies the input group needed for /dev/uinput and /dev/input/event*.
# systemd user units cannot set SupplementaryGroups=, and the group added to
# /etc/passwd on 2026-08-01 only reaches the user manager after a fresh login —
# sg makes this work in the current session too. It stays a harmless no-op once
# the group is inherited natively.
#
# The default KillMode=control-group signals every process in the cgroup, so
# `systemctl --user stop xremap` reaches xremap itself, not just the sg wrapper.
# That matters: stopping the unit is the escape hatch that releases the keyboard
# grab, and it must work over SSH from the Mac.
ExecStart=/usr/bin/sg input -c "/home/abdullah/.local/bin/xremap /home/abdullah/.config/xremap/config.yml"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
