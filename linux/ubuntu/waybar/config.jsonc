// Waybar config for the Ubuntu Hyprland session.
// Single top bar. Minimal: workspaces / clock / network + audio + battery + tray.
// Valid JSONC for waybar 0.15 (comments + trailing commas allowed).
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "memory", "cpu", "network", "pulseaudio", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "clock": {
    "format": "{:%a %b %d   %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },

  "custom/gpu": {
    "format": "GPU {}%",
    "interval": 5,
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -n1",
    "tooltip": false
  },

  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2,
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " {ifname}",
    "format-disconnected": "睊",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    // Left-click opens the full mixer.
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
