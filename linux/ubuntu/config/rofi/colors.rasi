/* generated by ~/.local/bin/theme — edit the theme.lua, not this file.
   (currently hand-seeded with everforest while we tune the look) */
* {
    bg:         #2d353b;
    window-bg:  #2d353bcc;   /* ~80% — lets the frosted blur read as the hero */
    surface:    #3a464d;     /* lifted pill for the search input        */
    fg:         #d3c6aa;
    fg-dim:     #d3c6aa80;    /* placeholder / secondary                 */
    accent:     #dbbc7f;
    accent-fg:  #2d353b;      /* text sitting on the accent highlight    */
    urgent:     #e67e80;
}
