#!/usr/bin/env bash
# shellcheck shell=bash
# Open a new window of the currently focused app under Hyprland.
# Bound to SUPER+N. Falls back to Ghostty
# when nothing is focused or the focused window has no class.

set -euo pipefail

class=$(hyprctl activewindow -j | jq -r '.class // empty')

# Nothing focused (e.g. empty workspace) -> a terminal is the sane default.
[ -z "$class" ] && exec ghostty

case "$class" in
  # Browsers: window class differs from binary name, so map explicitly.
  google-chrome*|Google-chrome*)   exec google-chrome --new-window ;;
  chromium*|Chromium*)             exec chromium --new-window ;;
  firefox*|Firefox*)               exec firefox --new-window ;;
  brave*|Brave-browser*)           exec brave --new-window ;;

  com.mitchellh.ghostty|ghostty)   exec ghostty ;;

  # Chrome web apps (the Alt keys). Class is chrome-<host>__<path><profile>, so
  # recover the full URL from the installed launcher rather than rebuilding it
  # from the host, which would drop a path like substack.com/home.
  chrome-*__*)
    host=${class#chrome-}
    host=${host%%__*}
    url=$(sed -nE "s|^Exec=omarchy-launch-webapp +\"?(https?://[^\" ]*${host}[^\" ]*)\"?.*|\1|p" \
      "$HOME"/.local/share/applications/*.desktop 2>/dev/null | head -n1)
    exec omarchy-launch-webapp "${url:-https://$host}"
    ;;

  Code|code|code-url-handler)      exec code -n ;;

  # Unknown app: try launching its class, then a lowercased class as a
  # binary name (Hyprland class names are often Capitalized, binaries aren't).
  *)
    if command -v "$class" >/dev/null 2>&1; then
      hyprctl dispatch exec -- "$class"
    else
      lc=$(printf '%s' "$class" | tr '[:upper:]' '[:lower:]')
      if command -v "$lc" >/dev/null 2>&1; then
        hyprctl dispatch exec -- "$lc"
      else
        hyprctl dispatch exec -- "$class"
      fi
    fi
    ;;
esac
