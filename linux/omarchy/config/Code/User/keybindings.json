// Linux, VS Code. Same map as config/Cursor/User/keybindings.json (2026-09-09):
// the two editors share one keymap so muscle memory carries across. Cursor is a
// VS Code fork, so on Linux the whole Ctrl set in KEYBINDINGS.md is already stock
// in both; only these rules differ.
//
// Super+C/V reach the editor as Ctrl+C/V (xremap, GUI apps only), so the editor
// already copies/pastes. The integrated terminal needs two rules so the same keys
// behave like Cmd+C/V on the Mac: copy when text is selected (otherwise Ctrl+C
// stays the interrupt), and paste on Ctrl+V.
[
  { "key": "ctrl+c", "command": "workbench.action.terminal.copySelection", "when": "terminalFocus && terminalTextSelected" },
  { "key": "ctrl+v", "command": "workbench.action.terminal.paste", "when": "terminalFocus" },

  // Super+T = new tab in every tool (2026-09-08); here a new untitled file.
  // xremap leaves Super+T raw for VS Code (Ctrl+T is the terminal toggle below).
  { "key": "meta+t", "command": "workbench.action.files.newUntitledFile", "when": "!terminalFocus" },

  // Comfort rebinds for the two toggles pressed all day. Ctrl+B and Ctrl+`
  // stay bound as well, these are additions, not replacements.
  // Ctrl+E default was a duplicate of Ctrl+P, and Ctrl+T was Go to Symbol
  // in Workspace (Ctrl+Shift+O still covers symbols in the open file).
  // Cursor guards Ctrl+T with !composerFocused; VS Code has no equivalent
  // context key, so this one is unguarded.
  // Ctrl+E is the file tree, not "whatever the side bar showed last": the Claude
  // view shares the primary side bar, so a plain toggle could reopen Claude.
  { "key": "ctrl+e", "command": "workbench.view.explorer", "when": "!explorerViewletVisible" },
  { "key": "ctrl+e", "command": "workbench.action.closeSidebar", "when": "explorerViewletVisible" },
  { "key": "ctrl+t", "command": "workbench.action.terminal.toggleTerminal" },

  // Ctrl+B = go to definition (the JetBrains key), a home-row stand-in for F12,
  // which stays bound. Editor focus only, so the terminal keeps Ctrl+B (tmux,
  // readline). The stock Ctrl+B side bar toggle is dropped: Ctrl+E owns that.
  { "key": "ctrl+b", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus && !isInEmbeddedEditor" },
  { "key": "ctrl+b", "command": "-workbench.action.toggleSidebarVisibility" },

  // Ctrl+Shift+F opens project search as a full-width search editor
  // ("search.mode": "newEditor"); pressed again inside it, it closes the page,
  // so it toggles like Ctrl+E and Ctrl+L.
  { "key": "ctrl+shift+f", "command": "workbench.action.closeActiveEditor", "when": "inSearchEditor" },

  // Ctrl-only editing set (2026-09-20). Alt belongs to the Hyprland app launchers,
  // so the editing keys that were Alt- or F-row-based get a Ctrl twin; the stock
  // keys stay bound. The arrows are one family: Ctrl = selection, Ctrl+Shift =
  // move lines (Sublime), Ctrl+Alt = add cursors (VS Code on Windows), next to the
  // stock Ctrl+Alt+Left/Right that moves a file between splits. Editor focus only.
  { "key": "ctrl+up", "command": "editor.action.smartSelect.expand", "when": "editorTextFocus" },
  { "key": "ctrl+down", "command": "editor.action.smartSelect.shrink", "when": "editorTextFocus" },
  { "key": "ctrl+shift+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly" },
  { "key": "ctrl+shift+down", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly" },
  { "key": "ctrl+alt+up", "command": "editor.action.insertCursorAbove", "when": "editorTextFocus" },
  { "key": "ctrl+alt+down", "command": "editor.action.insertCursorBelow", "when": "editorTextFocus" },
  { "key": "ctrl+alt+i", "command": "editor.action.insertCursorAtEndOfEachLineSelected", "when": "editorTextFocus" },
  // Usages sits next to Ctrl+B (definition); rename takes the near-empty refactor menu's key.
  { "key": "ctrl+shift+b", "command": "editor.action.goToReferences", "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor" },
  { "key": "ctrl+shift+r", "command": "editor.action.rename", "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly" },

  // AI pane on Ctrl+L, Cursor's chat key (2026-09-09), and Ctrl+L again closes it.
  // claude-vscode.sideBarActive is true while a Claude chat surface is visible.
  // Which bar holds it varies: the extension puts it in the secondary side bar
  // (auxiliary), but the view can be moved into the primary one so it shares the
  // right edge with the file tree. So close the bar whose active entry is Claude
  // (activeAuxiliary / activeViewlet), and leave the other bar alone.
  // Ctrl+I and Ctrl+K are left alone: Cursor's composer and inline edit have no
  // Claude Code equivalent, and Ctrl+K stays VS Code's chord prefix. Terminal
  // keeps Ctrl+L (clear).
  { "key": "ctrl+l", "command": "claude-vscode.sidebar.open", "when": "!terminalFocus && !claude-vscode.sideBarActive" },
  { "key": "ctrl+l", "command": "workbench.action.closeAuxiliaryBar", "when": "!terminalFocus && claude-vscode.sideBarActive && activeAuxiliary == 'workbench.view.extension.claude-sidebar-secondary'" },
  { "key": "ctrl+l", "command": "workbench.action.closeSidebar", "when": "!terminalFocus && claude-vscode.sideBarActive && activeViewlet == 'workbench.view.extension.claude-sidebar-secondary'" },

  // Run the current file. Python goes straight to the terminal (no debugger);
  // everything else starts without debugging. Editor focus only, so Ctrl+Enter
  // keeps its chat and Jupyter-cell meanings.
  { "key": "ctrl+enter", "command": "python.execInTerminal", "when": "editorTextFocus && editorLangId == python && !jupyter.hascodecells" },
  { "key": "ctrl+enter", "command": "workbench.action.debug.run", "when": "editorTextFocus && editorLangId != python && !(isDbtWorkspace && isSqlFile)" },

  // dbt model files: Ctrl+Enter previews the query (official dbt extension),
  // instead of falling into the generic run-without-debugging rule above.
  { "key": "ctrl+enter", "command": "dbt.previewFile", "when": "editorTextFocus && isDbtWorkspace && isSqlFile" }
]
