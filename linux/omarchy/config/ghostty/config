# Omarchy owns the colors (regenerated on every theme switch).
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

font-family = JetBrainsMono Nerd Font
font-family = Cairo
font-family = Noto Color Emoji
font-size = 10.5
font-feature = -liga
font-feature = -calt
confirm-close-surface = false
copy-on-select = false
working-directory = home
window-inherit-working-directory = false
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
async-backend = epoll

keybind = shift+enter=text:\n
keybind = performable:super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+t=new_tab
