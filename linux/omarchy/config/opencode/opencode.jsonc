{
  "$schema": "https://opencode.ai/config.json",
  // mise and Omarchy own updates. Disable self-updates.
  "update": "disable",
  "share": "disabled",
  // ChatGPT and OpenCode Go are his subscriptions; nothing else is enabled.
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "allow"
    }
  ],
  "model": "openai/gpt-6.1-sol#high",
  "agents": {
    "title": {
      "model": "openai/gpt-6.1-sol"
    },
    "general-purpose": {
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks."
    }
  },
  // Every tool runs without asking. Only nested non-Rai skills are hidden.
  "permissions": [
    {"action": "*", "resource": "*", "effect": "allow"},
    // Claude Code's synced skills live in ~/.claude/skills, which opencode also scans: keep them hidden.
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "skill", "resource": "artifact-emulator", "effect": "deny"},
    {"action": "skill", "resource": "built-in-browser", "effect": "deny"},
    {"action": "skill", "resource": "chrome-browser", "effect": "deny"},
    {"action": "skill", "resource": "computer-use", "effect": "deny"},
    {"action": "skill", "resource": "deep-research", "effect": "deny"},
    {"action": "skill", "resource": "docs", "effect": "deny"},
    {"action": "skill", "resource": "docx", "effect": "deny"},
    {"action": "skill", "resource": "google-workspace", "effect": "deny"},
    {"action": "skill", "resource": "import-memory", "effect": "deny"},
    {"action": "skill", "resource": "morning", "effect": "deny"},
    {"action": "skill", "resource": "pdf", "effect": "deny"},
    {"action": "skill", "resource": "pptx", "effect": "deny"},
    {"action": "skill", "resource": "skill-creator", "effect": "deny"},
    {"action": "skill", "resource": "xlsx", "effect": "deny"},
    {"action": "shell", "resource": "*", "effect": "allow"}
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@latest"
        ],
        "disabled": false
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
