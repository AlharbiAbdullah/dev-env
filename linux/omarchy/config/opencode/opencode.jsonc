{
  "$schema": "https://opencode.ai/config.json",
  // mise pins the binary (config/mise/config.toml): opencode must not replace itself.
  "autoupdate": false,
  // No public share links: Claude Code has no share path either.
  "share": "disabled",
  // Only the providers he pays for: ChatGPT sign-in and Ollama Pro. This hides the free
  // Zen models (some train on prompts) and OpenRouter, whose key his shell exports.
  "enabled_providers": ["openai", "ollama"],
  "model": "ollama/deepseek-v4-pro:cloud",
  // Session titles: the session model already served most of them; this keeps the title
  // call off the Sol allowance.
  "small_model": "ollama/deepseek-v4.1-flash:cloud",
  // No guards, his ruling 2026-10-07: every tool runs without asking, as he works in Claude Code.
  // The skill block only hides skills that are not Rai's.
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "external_directory": "allow",
    // rai:render begin skill (03-rai/harness/opencode/render_config.py rewrites this block)
    "skill": {
      "*": "allow",
      "built-in-browser": "deny",
      "chrome-browser": "deny",
      "computer-use": "deny",
      "db": "deny",
      "deep-research": "deny",
      "deploy": "deny",
      "docs": "deny",
      "docx": "deny",
      "google-workspace": "deny",
      "import-memory": "deny",
      "morning": "deny",
      "pdf": "deny",
      "pptx": "deny",
      "run-{SERVICE}": "deny",
      "sdd": "deny",
      "skill-creator": "deny",
      "xlsx": "deny"
    },
    // rai:render end skill
    "doom_loop": "allow"
  },
  // Same server Claude Code registers at user scope (dev-env claude-config.sh).
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  },
  // OpenCode turns every skill into a slash command and expands $1..$N and !`cmd` in its
  // body, which can swallow the question. A config command wins over the skill's own, and
  // loads the council skill the way Claude Code does, so `/council <question>` keeps it.
  "command": {
    "council": {
      "description": "Multi-model panel on his subscriptions (the council skill)",
      "template": "Load the council skill with the skill tool, then follow it for this request.\n\nARGUMENTS: $ARGUMENTS"
    }
  },
  // Claude Code's name for the built-in general agent, which Rai workflows name.
  "agent": {
    "general-purpose": {
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks."
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-6.1-sol": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    },
    // Ollama's openai-compatible route has no models.dev entry, so each model says it
    // reasons and carries its effort levels; with no variant picked no effort is sent.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "kimi-k3:cloud": {
          "name": "Kimi K3 (Ollama)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "kimi-k2.7-code:cloud": {
          "name": "Kimi K2.7 Code (Ollama)",
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "glm-5.3:cloud": {
          "name": "GLM-5.3 (Ollama)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "glm-5.3-flash:cloud": {
          "name": "GLM-5.3 Flash (Ollama)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "deepseek-v4-pro:cloud": {
          "name": "DeepSeek V4 Pro (Ollama)",
          "reasoning": true,
          // The default model: opens at Ollama's top effort with no variant picked.
          "options": { "reasoningEffort": "high" },
          "limit": { "context": 1048576, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "deepseek-v4.1-flash:cloud": {
          "name": "DeepSeek V4.1 Flash (Ollama)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "minimax-m3:cloud": {
          "name": "MiniMax M3 (Ollama)",
          "reasoning": true,
          "limit": { "context": 512000, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-oss:120b-cloud": {
          "name": "gpt-oss 120B (Ollama)",
          "reasoning": true,
          "limit": { "context": 131072, "output": 32768 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  }
}
