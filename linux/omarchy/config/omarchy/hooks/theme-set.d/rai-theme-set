#!/usr/bin/env bash
# Runs after `omarchy theme set <name>` ($1 = theme name).
# Omarchy already handles: Hyprland border, Ghostty, Chrome color, VS Code + Cursor,
# gsettings light/dark, wallpaper, shell, Claude Code, pi, tmux.conf colors.
# This hook covers what Omarchy does not: tmux status bar (own layout), starship
# palette, and the ~/.config/themes/current.lua compat pointer (opencode theme-sync,
# fastfetch, and any script that still reads it).
set -uo pipefail
name="$1"
THEMES_DIR="$HOME/.config/themes"
src="$THEMES_DIR/$name/theme.lua"
[[ -f "$src" ]] || exit 0

ln -sfn "$src" "$THEMES_DIR/current.lua"

if grep -qE '^palette\s*=' "$HOME/.config/starship.toml" 2>/dev/null; then
  sed -i -E "s|^palette[[:space:]]*=.*|palette = \"$name\"|" "$HOME/.config/starship.toml"
fi

if command -v tmux >/dev/null 2>&1; then
  mkdir -p "$HOME/.config/tmux"
  border=$(grep -oE 'border\s*=\s*"0x[0-9a-fA-F]{8}"' "$src" | grep -oE '[0-9a-fA-F]{8}' | head -1)
  accent="#${border: -6}"
  python3 - "$src" "$HOME/.config/tmux/theme.conf" "$accent" <<'PY'
import re, sys
src, out, accent = sys.argv[1], sys.argv[2], sys.argv[3]
t = open(src).read()
def field(name):
    m = re.search(r'\b' + name + r'\s*=\s*"([^"]+)"', t); return m.group(1) if m else None
def arr(name):
    m = re.search(r'\b' + name + r'\s*=\s*\{(.*?)\}', t, re.S)
    return re.findall(r'#[0-9a-fA-F]{6}', m.group(1)) if m else []
base = field('background') or '#1c2027'; text = field('foreground') or '#d3c6aa'
sel_bg = field('selection_bg') or text; sel_fg = field('selection_fg') or base
ansi = arr('ansi'); surface = ansi[0] if ansi else base; info = ansi[4] if len(ansi) > 4 else accent
lb, rb = '', ''
lines = [
 '# generated by rai-theme-set hook: edit the theme.lua, not this file',
 'set -g status on', 'set -g status-interval 30', 'set -g status-position bottom', 'set -g status-justify left',
 f'set -g status-style "bg={base},fg={text}"', 'set -g status-left-length 40', 'set -g status-right-length 60',
 f'set -g status-left "#[fg={info},bg={base}]{lb}#[fg={base},bg={info},bold] #S #[fg={info},bg={base}]{rb} "',
 f'set -g status-right "#[fg={info},bg={base}]{lb}#[fg={base},bg={info},bold] %H:%M #[fg={info},bg={base}]{rb}"',
 'set -g window-status-separator ""',
 f'set -g window-status-format "#[fg={text},bg={base}]  #I:#W "',
 f'set -g window-status-current-format "#[fg={accent},bg={base}]{lb}#[fg={base},bg={accent},bold] #I:#W #[fg={accent},bg={base}]{rb}"',
 f'set -g pane-active-border-style "fg={accent}"', f'set -g pane-border-style "fg={surface}"',
 f'set -g message-style "bg={accent},fg={base}"', f'set -g message-command-style "bg={accent},fg={base}"',
 f'set -g mode-style "bg={sel_bg},fg={sel_fg}"', f'set -g clock-mode-colour "{accent}"',
]
open(out, 'w').write('\n'.join(lines) + '\n')
PY
  tmux ls >/dev/null 2>&1 && tmux source-file "$HOME/.config/tmux/theme.conf" 2>/dev/null || true
fi
