{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900
  },
  "bar": {
    "id": "abdullah.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "abdullah.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd MMM d   h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "sysstats",
          "type": "qml"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "abdullah.agents",
          "providers": {
            "claude": {
              "enabled": true
            },
            "codex": {
              "enabled": false
            },
            "fireworks": {
              "enabled": false
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.monitor"
        }
      ]
    }
  },
  "plugins": []
}
