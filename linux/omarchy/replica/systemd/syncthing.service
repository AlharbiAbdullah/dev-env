[Unit]
Description=Syncthing home folders on the ARM replica
OnFailure=alert@%N.service
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
ExecStart=%h/.local/bin/syncthing serve --no-browser --no-restart
Restart=on-failure
RestartSec=1
SuccessExitStatus=3 4
RestartForceExitStatus=3 4
NoNewPrivileges=true

[Install]
WantedBy=default.target
