// Let 1Password unlock without a password prompt for user abdullah.
// Covers: app unlock, SSH agent access, CLI access.
// Convenience trade-off: anyone with access to abdullah's unlocked desktop
// session can open the vault / use the SSH agent + CLI with no barrier.
// Delete this file (and restart polkit) to revert.
polkit.addRule(function(action, subject) {
    if (subject.user == "abdullah" &&
        (action.id == "com.1password.1Password.unlock" ||
         action.id == "com.1password.1Password.authorizeSshAgent" ||
         action.id == "com.1password.1Password.authorizeCLI")) {
        return polkit.Result.YES;
    }
});
