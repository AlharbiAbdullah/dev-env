#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Write local usage records for the per-harness agent tabs.

Omarchy's `omarchy-agent-usage-update` owns claude, codex and fireworks and
runs from `$OMARCHY_PATH/bin`, so a user collector cannot join its glob. The
agents panel, however, just reads one JSON record per agent from the usage
directory, so this companion writes the harness tabs the stock collectors do
not cover: pi, opencode and agy. agy's record also carries the Google AI Pro
quota windows, read from agy's own `/usage` command. pi and opencode carry two
subscriptions: Ollama Pro's windows, read with the Ollama API key, and ChatGPT
Plus's, read through the Codex CLI. Every window names its subscription (`sub`)
and plan, so the AI tab can draw one card per subscription.

Invoked by the `agents-local` systemd timer, which also refreshes the synthetic
"AI" record: one row per model and effort across Claude Code, Codex, pi and opencode
(every token: input, output, cache reads and cache writes, as on the Claude Code tab).
opencode counts /council voices' private databases too. Pass agent ids to refresh a subset.
"""

import functools
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import threading
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
USAGE_DIR = STATE / "omarchy" / "agents" / "usage"
TODAY = datetime.now().strftime("%Y-%m-%d")
RECENT_DATES = [
    (datetime.now() - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)
]

AGENTS = ["pi", "opencode", "agy", "codex-cli"]
# The AI tab aggregates every harness by model and effort. It is rebuilt on every
# timer run (~5 s for ~1.8 GB of Claude transcripts), so its seven days stay current.
AI_ID = "0-ai"

AGY_BIN = shutil.which("agy") or str(Path.home() / ".local" / "bin" / "agy")
CODEX_BIN = shutil.which("codex") or str(Path.home() / ".local" / "share" / "mise" / "shims" / "codex")
# Filled by `__op_env OLLAMA_USAGE_KEY` in ~/.bashrc.local (per-boot RAM, 0700 dir).
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
OLLAMA_KEY = RUNTIME / "op-OLLAMA_USAGE_KEY"
OLLAMA_PRO_CREDIT_USD = 60  # Pro: $60 of usage credit a month (ollama.com/pricing, 2026-10)
OLLAMA_PRO_RENEWAL_DAY = 1  # Pro renews on the 1st of each month (02-ana/financial/subscriptions.md)


def number(value):
    try:
        return int(value or 0)
    except Exception:
        return 0


def local_day(value):
    if value is None:
        return TODAY
    if isinstance(value, (int, float)):
        if value > 10_000_000_000:  # milliseconds
            value = value / 1000
        return datetime.fromtimestamp(value).strftime("%Y-%m-%d")
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if dt.tzinfo is not None:
            dt = dt.astimezone()
        return dt.strftime("%Y-%m-%d")
    except Exception:
        return TODAY


def label(model, effort):
    """A model key that carries the effort when there is one, for the AI tab."""
    base = str(model or "unknown").split("/")[-1].replace(":cloud", "")
    effort = str(effort or "").strip()
    return f"{base} ({effort})" if effort else base


class Stats:
    """Token and session accumulator for one agent."""

    def __init__(self):
        self.recent = {day: 0 for day in RECENT_DATES}
        self.today_prompts = 0
        self.today_sessions = set()
        self.today_tokens_by_model = {}
        self.model_usage = {}
        self.recent_model_usage = {}
        self.total_prompts = 0
        self.total_sessions = set()
        self.active_days = set()

    def add(self, day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
        total = input_tokens + output_tokens + cache_read + cache_write
        self.total_prompts += 1
        self.total_sessions.add(session_key)
        self.active_days.add(day)
        bucket = self.model_usage.setdefault(
            model, {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0}
        )
        bucket["inputTokens"] += input_tokens
        bucket["outputTokens"] += output_tokens
        bucket["cacheReadInputTokens"] += cache_read
        bucket["cacheCreationInputTokens"] += cache_write
        if day in self.recent:
            self.recent[day] += total
            week = self.recent_model_usage.setdefault(model, dict.fromkeys(bucket, 0))
            week["inputTokens"] += input_tokens
            week["outputTokens"] += output_tokens
            week["cacheReadInputTokens"] += cache_read
            week["cacheCreationInputTokens"] += cache_write
        if day == TODAY:
            self.today_prompts += 1
            self.today_sessions.add(session_key)
            self.today_tokens_by_model[model] = self.today_tokens_by_model.get(model, 0) + total

    def add_session(self, day, session_key):
        self.total_sessions.add(session_key)
        self.active_days.add(day)
        if day == TODAY:
            self.today_sessions.add(session_key)

    def record(self, agent_id, name, tier="", has_prompt_stats=True):
        return {
            "schemaVersion": 1,
            "id": agent_id,
            "name": name,
            "updatedAt": datetime.now().astimezone().isoformat(),
            "ready": True,
            "hasLocalStats": True,
            "hasPromptStats": has_prompt_stats,
            "tierLabel": tier,
            "limits": [],
            "balance": None,
            "todayPrompts": self.today_prompts,
            "todaySessions": len(self.today_sessions),
            "todayTotalTokens": sum(self.today_tokens_by_model.values()),
            "todayTokensByModel": self.today_tokens_by_model,
            "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in RECENT_DATES],
            "totalPrompts": self.total_prompts,
            "totalSessions": len(self.total_sessions),
            "activeDays": len(self.active_days),
            "activeDates": sorted(self.active_days),
            "modelUsage": self.model_usage,
        }


def usage_from_parts(usage):
    input_tokens = number(usage.get("input"))
    output_tokens = number(usage.get("output"))
    cache_read = number(usage.get("cacheRead"))
    cache_write = number(usage.get("cacheWrite"))
    if not (input_tokens or output_tokens or cache_read or cache_write):
        total = number(usage.get("totalTokens"))
        if total:
            input_tokens = total
    return input_tokens, output_tokens, cache_read, cache_write


def scan_pi(stats=None, effort=False):
    """Every pi (and omp) assistant message, whatever provider it ran on.

    With effort=True the model key carries the session's thinking level, for
    the AI tab.
    """
    stats = stats or Stats()
    seen = set()
    roots = [
        Path.home() / ".pi" / "agent" / "sessions",
        Path.home() / ".omp" / "agent" / "sessions",
    ]
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            level = ""
            try:
                lines = path.read_text(errors="replace").splitlines()
            except OSError:
                continue
            for raw in lines:
                try:
                    entry = json.loads(raw)
                except Exception:
                    continue
                if entry.get("type") == "thinking_level_change":
                    level = str(entry.get("thinkingLevel") or "")
                    continue
                if entry.get("type") != "message":
                    continue
                key = (str(path), str(entry.get("id") or ""))
                if key in seen:
                    continue
                seen.add(key)
                message = entry.get("message") or {}
                if message.get("role") != "assistant":
                    continue
                input_tokens, output_tokens, cache_read, cache_write = usage_from_parts(
                    message.get("usage") or {}
                )
                if not (input_tokens or output_tokens or cache_read or cache_write):
                    continue
                model = str(message.get("model") or "unknown")
                if effort:
                    model = label(model, level)
                day = local_day(entry.get("timestamp") or message.get("timestamp"))
                stats.add(day, str(path), model, input_tokens, output_tokens, cache_read, cache_write)
    return stats


def opencode_databases():
    """His opencode database, plus the private one each /council voice keeps
    under the Rai state folder: those voices run on the same subscriptions."""
    main = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "opencode" / "opencode.db"
    voices = sorted(STATE.glob("rai/*/opencode/*/data/opencode/opencode.db"))
    return [db for db in [main, *voices] if db.is_file()]


def scan_opencode(stats=None, effort=False):
    """Every opencode assistant message, whatever provider it ran on."""
    stats = stats or Stats()
    for db in opencode_databases():
        scan_opencode_db(db, stats, effort)
    return stats


def scan_opencode_db(db, stats, effort):
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    try:
        conn.execute("PRAGMA query_only = ON")
        rows = conn.execute(
            "SELECT session_id, data FROM message"
            " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
            " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
        )
        for session_id, raw in rows:
            try:
                entry = json.loads(raw)
                if not isinstance(entry, dict) or entry.get("role") != "assistant":
                    continue
                tokens = entry.get("tokens") or {}
                cache = tokens.get("cache") or {}
                input_tokens = number(tokens.get("input"))
                output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
                cache_read = number(cache.get("read"))
                cache_write = number(cache.get("write"))
                if not (input_tokens or output_tokens or cache_read or cache_write):
                    continue
                day = local_day((entry.get("time") or {}).get("created"))
                model = str(entry.get("modelID") or "unknown").rstrip("/").split("/")[-1]
                if effort:
                    model = label(model, entry.get("variant"))
            except Exception:
                continue
            stats.add(day, "opencode:" + str(session_id), model, input_tokens, output_tokens, cache_read, cache_write)
    finally:
        conn.close()


def scan_claude(stats=None):
    """Claude Code transcripts: model, effort, and every token (input, output,
    cache reads and cache writes).

    Claude Code logs one line per content block (thinking, text, tool use), each
    carrying the reply's usage as it stood then, so an early block's output count
    is partial. A resumed session copies earlier replies into its new file. One
    reply counts once, by message and request id, at its final (largest) count.
    """
    stats = stats or Stats()
    root = Path.home() / ".claude" / "projects"
    if not root.exists():
        return stats
    replies = {}
    for path in root.rglob("*.jsonl"):
        try:
            handle = path.open(errors="replace")
        except OSError:
            continue
        with handle:
            for line, raw in enumerate(handle):
                try:
                    entry = json.loads(raw)
                except Exception:
                    continue
                message = entry.get("message") or {}
                if not isinstance(message, dict) or message.get("role") != "assistant":
                    continue
                usage = message.get("usage") or {}
                model = str(message.get("model") or "")
                if not usage or model in ("", "<synthetic>"):
                    continue
                counts = [
                    number(usage.get("input_tokens")),
                    number(usage.get("output_tokens")),
                    number(usage.get("cache_read_input_tokens")),
                    number(usage.get("cache_creation_input_tokens")),
                ]
                if not any(counts):
                    continue
                reply = (message.get("id"), entry.get("requestId"))
                if not reply[0]:
                    reply = (str(path), line)
                row = replies.get(reply)
                if row is None:
                    replies[reply] = [
                        local_day(entry.get("timestamp")), str(path),
                        label(model, entry.get("effort") or entry.get("perTurnEffort")),
                        *counts,
                    ]
                else:
                    row[3:] = [max(old, new) for old, new in zip(row[3:], counts)]
    for day, session, model, *counts in replies.values():
        stats.add(day, session, model, *counts)
    return stats


def scan_codex(stats=None, effort=False):
    """Codex CLI sessions: each turn's tokens, by model (and effort for the AI tab).

    A token_count event carries the last turn's usage. Its input_tokens include
    the cached part and its output_tokens the reasoning, so the cache is split
    out once and nothing counts twice. Codex repeats an event with an unchanged
    running total, so a repeat is skipped.
    """
    stats = stats or Stats()
    root = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    for folder in ("sessions", "archived_sessions"):
        if not (root / folder).exists():
            continue
        for path in (root / folder).rglob("*.jsonl"):
            model, level, running = "codex", "", None
            try:
                lines = path.read_text(errors="replace").splitlines()
            except OSError:
                continue
            for raw in lines:
                try:
                    entry = json.loads(raw)
                except Exception:
                    continue
                payload = entry.get("payload")
                if not isinstance(payload, dict):
                    continue
                if entry.get("type") == "turn_context":
                    mode = (payload.get("collaboration_mode") or {}).get("settings") or {}
                    model = str(payload.get("model") or model)
                    level = str(payload.get("effort") or mode.get("reasoning_effort") or "")
                    continue
                if payload.get("type") != "token_count":
                    continue
                info = payload.get("info") or {}
                if info.get("total_token_usage") is not None:
                    if info["total_token_usage"] == running:
                        continue
                    running = info["total_token_usage"]
                usage = info.get("last_token_usage") or {}
                cache_read = number(usage.get("cached_input_tokens"))
                input_tokens = max(0, number(usage.get("input_tokens")) - cache_read)
                output_tokens = number(usage.get("output_tokens"))
                if not (input_tokens or output_tokens or cache_read):
                    continue
                key = label(model, level) if effort else model
                stats.add(local_day(entry.get("timestamp")), str(path), key, input_tokens, output_tokens, cache_read, 0)
    return stats


def scan_ai():
    """One row per model and effort across every harness that counts tokens."""
    stats = Stats()
    scan_pi(stats, effort=True)
    scan_opencode(stats, effort=True)
    scan_claude(stats)
    scan_codex(stats, effort=True)
    record = stats.record(AI_ID, "AI", "every model")
    # The model chart covers the same seven days as the day chart above it.
    record["modelUsage"] = stats.recent_model_usage
    return record


def scan_agy():
    """Antigravity CLI sessions. It stores no readable token counts, so the
    record carries session and day activity only."""
    stats = Stats()
    db = Path.home() / ".gemini" / "antigravity-cli" / "conversation_summaries.db"
    if not db.is_file():
        return stats
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    try:
        conn.execute("PRAGMA query_only = ON")
        for conversation_id, ts in conn.execute(
            "SELECT conversation_id, last_user_input_time FROM conversation_summaries"
        ):
            day = local_day(ts)
            if day < "2000":  # a conversation with no input yet carries a zero time
                continue
            stats.add_session(day, "agy:" + str(conversation_id))
    finally:
        conn.close()
    return stats


def carried_limits(agent_id):
    """The last record's windows, emptied once their reset has passed."""
    try:
        limits = json.loads((USAGE_DIR / f"{agent_id}.json").read_text()).get("limits") or []
    except Exception:
        return []
    now = datetime.now().astimezone()
    for limit in limits:
        try:
            reset = datetime.fromisoformat(str(limit.get("resetsAt")).replace("Z", "+00:00"))
        except ValueError:
            continue
        if reset <= now:
            limit["percent"] = 0.0
            limit["resetsAt"] = ""
    return limits


def agy_limits():
    """Google AI Pro quota from agy's own `/usage` command: four windows.

    Gemini models share one pool and the partner models (Claude, GPT-OSS)
    another, each with a 5-hour and a weekly window. `/usage` is a local slash
    command (no turn, no tokens, no hooks), and agy refreshes its own sign-in,
    which its token file on disk does not keep up with. Its log goes to
    /dev/null, or every run would leave a file in agy's log folder. A failed
    read carries the last windows forward.
    """
    try:
        result = subprocess.run(
            [AGY_BIN, "--log-file", os.devnull, "--output-format", "json", "-p", "/usage"],
            capture_output=True, text=True, timeout=60, cwd=tempfile.gettempdir(), check=False,
        )
        payload = json.loads(result.stdout[result.stdout.index("{"):])
        groups = payload["command"]["data"]["groups"]
    except Exception:
        return carried_limits("agy")
    windows = []
    for group in groups:
        pool = "Gemini" if str(group.get("name", "")).lower().startswith("gemini") else "Claude/GPT"
        for bucket in group.get("buckets") or []:
            weekly = bucket.get("window") == "weekly"
            used = round(1 - float(bucket.get("remaining_fraction", 1)), 4)
            windows.append({
                "label": f"{pool} {'Weekly (7-day)' if weekly else 'Session (5-hour)'}",
                "title": f"{pool} {'week' if weekly else '5h'}",
                "sub": "Google",
                "plan": "AI Pro",
                "percent": max(0.0, used),
                # An untouched window reports a reset that rolls forward with the clock.
                "resetsAt": bucket.get("reset_time", "") if used > 0 else "",
            })
    # Gemini before Claude/GPT, the 5-hour window before the week, as the other tabs read.
    windows.sort(key=lambda w: (w["title"].startswith("Claude"), "Weekly" in w["label"]))
    return windows


def agy_record():
    record = scan_agy().record("agy", "agy", "Google AI Pro", has_prompt_stats=False)
    # agy keeps no readable token counts: no day chart rather than seven empty bars.
    record["recentDays"] = []
    record["limits"] = agy_limits()
    return record


def ollama_reset_at():
    """The date Ollama Pro's monthly credit renews: the 1st of next month.

    The usage API reports no reset time, so the panel's countdown would sit
    empty while every other card counts down. His billing date is fixed (the
    1st), so compute it locally.
    """
    now = datetime.now().astimezone()
    if now.month == 12:
        return datetime(now.year + 1, 1, OLLAMA_PRO_RENEWAL_DAY, tzinfo=now.tzinfo).isoformat()
    return datetime(now.year, now.month + 1, OLLAMA_PRO_RENEWAL_DAY, tzinfo=now.tzinfo).isoformat()


@functools.cache
def ollama_limits():
    """Ollama Pro's usage, as the fraction of its monthly credit spent.

    Since October 2026 /api/usage reports spend in USD over a range (24h, 7d or 30d), with no
    limits or reset times, and Pro is $60 of credit a month (ollama.com/pricing). The bar is
    the last 30 days' spend over that credit. The key comes from the RAM cache a shell's
    `__op_env` fills; the timer never calls op itself. No key or no answer means no bar.
    """
    try:
        request = urllib.request.Request(
            "https://ollama.com/api/usage?range=30d",
            headers={"Authorization": f"Bearer {OLLAMA_KEY.read_text().strip()}"},
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            spent = float((json.load(response).get("totals") or {})["usage_usd"])
    except Exception:
        return []
    return [{
        "label": f"30 days: ${spent:.2f} of ${OLLAMA_PRO_CREDIT_USD}", "title": "Ollama 30d",
        "sub": "Ollama", "plan": "Pro", "percent": spent / OLLAMA_PRO_CREDIT_USD, "resetsAt": ollama_reset_at(),
    }]


def codex_rpc(proc, request_id, method, params=None):
    """One JSON-RPC call to `codex app-server`; skips notifications until the reply."""
    message = {"id": request_id, "method": method}
    if params is not None:
        message["params"] = params
    proc.stdin.write(json.dumps(message) + "\n")
    proc.stdin.flush()
    while True:
        line = proc.stdout.readline()
        if not line:
            raise RuntimeError("codex app-server closed")
        reply = json.loads(line)
        if reply.get("id") == request_id:
            return reply


def last_openai_windows(reason):
    """The last good OpenAI windows, so one failed read does not drop the card.

    A window past its reset no longer holds, so it goes. The reason lands in the
    journal, so the next hang shows its cause.
    """
    print(f"agents-local: OpenAI limits read failed ({reason}); kept the last reading", file=sys.stderr)
    try:
        record = json.loads((USAGE_DIR / "codex-cli.json").read_text())
    except (OSError, ValueError):
        return []
    now = datetime.now(timezone.utc)
    kept = []
    for window in record.get("limits") or []:
        try:
            live = datetime.fromisoformat(window["resetsAt"]) > now
        except (KeyError, TypeError, ValueError):
            live = False
        if window.get("sub") == "OpenAI" and live:
            kept.append(window)
    return kept


@functools.cache
def openai_limits():
    """ChatGPT Plus's 5-hour and weekly windows, read through the Codex CLI.

    Sign in with ChatGPT gives apps no usage API, but pi and opencode draw on
    the same Codex allowance the Codex app server reports (as Omarchy's own
    codex collector reads it). Needs `codex login` once; no login, no windows.
    """
    errors = tempfile.TemporaryFile("w+")
    try:
        proc = subprocess.Popen(
            [CODEX_BIN, "-s", "read-only", "-a", "on-request", "app-server"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors,
            text=True, cwd=tempfile.gettempdir(),
        )
    except OSError as error:
        return last_openai_windows(error)
    timer = threading.Timer(20, proc.kill)
    timer.start()
    try:
        codex_rpc(proc, 1, "initialize", {"clientInfo": {"name": "agents-local", "version": "1"}})
        proc.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n")
        proc.stdin.flush()
        limits = (codex_rpc(proc, 2, "account/rateLimits/read").get("result") or {}).get("rateLimits") or {}
    except Exception as error:
        reason = "timed out after 20 s" if timer.finished.is_set() else error
        proc.kill()
        proc.wait()
        errors.seek(0)
        return last_openai_windows(f"{reason}; codex stderr: {errors.read()[-500:].strip()}")
    finally:
        timer.cancel()
        proc.kill()
        proc.wait()
        errors.close()
    plan = str(limits.get("planType") or "").replace("_", " ").title()
    windows = []
    for window in (limits.get("primary"), limits.get("secondary")):
        if not isinstance(window, dict) or window.get("usedPercent") is None:
            continue
        weekly = number(window.get("windowDurationMins")) >= 7 * 24 * 60
        reset = window.get("resetsAt")
        windows.append({
            "label": "Weekly (7-day)" if weekly else "Session (5-hour)",
            "title": f"OpenAI {'week' if weekly else '5h'}",
            "sub": "OpenAI",
            "plan": plan,
            "percent": float(window["usedPercent"]) / 100,
            "resetsAt": datetime.fromtimestamp(number(reset), timezone.utc).isoformat() if reset else "",
        })
    return windows


def codex_record():
    record = scan_codex().record("codex-cli", "Codex", "ChatGPT Plus")
    record["limits"] = openai_limits()
    return record


def subscription_record(scan, agent_id):
    """opencode and pi run on two subscriptions, Ollama Pro and ChatGPT Plus, so
    both carry both sets of windows; each window names its subscription."""
    record = scan().record(agent_id, agent_id, "Ollama Pro · ChatGPT Plus")
    record["limits"] = ollama_limits() + openai_limits()
    return record


COLLECTORS = {
    "pi": lambda: subscription_record(scan_pi, "pi"),
    "opencode": lambda: subscription_record(scan_opencode, "opencode"),
    "agy": agy_record,
    # Omarchy's own codex record counts every ChatGPT-plan harness (opencode and
    # pi too), so it stays off; this tab is the Codex CLI alone.
    "codex-cli": codex_record,
}


def write_record(agent_id, record):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    handle_fd, tmp_name = tempfile.mkstemp(dir=USAGE_DIR, prefix=f".{agent_id}.", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(record, separators=(",", ":")) + "\n")
        tmp.chmod(0o644)
        tmp.replace(USAGE_DIR / f"{agent_id}.json")
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def main():
    args = sys.argv[1:]
    requested = [arg for arg in args if not arg.startswith("-")] or AGENTS + [AI_ID]
    status = 0
    for agent_id in requested:
        try:
            if agent_id == AI_ID:
                write_record(AI_ID, scan_ai())
            elif agent_id in COLLECTORS:
                write_record(agent_id, COLLECTORS[agent_id]())
            else:
                print(f"agents-local: unknown agent {agent_id}", file=sys.stderr)
                status = 1
        except Exception as exc:
            print(f"agents-local: {agent_id} collector failed ({exc})", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
