#!/usr/bin/env bash
# Weekly encrypted backup of the synced folders + helm to Google Drive via restic (rclone backend).
# Retention: GFS - keep 4 weekly, 12 monthly, all yearly. Log: ~/.local/state/backup-drive/last-run.log
set -uo pipefail
source "$HOME/.config/restic/env" || { echo "FAIL: cannot read restic environment" >&2; exit 1; }
STATE="$HOME/.local/state/backup-drive"; mkdir -p "$STATE"
LOG="$STATE/last-run.log"
FOLDERS=(dev-env personal playground projects reads work helm .ssh .config .local/state/rai .local/state/rai-maintenance .local/state/news-digest)
log(){ printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"; }
fail(){ log "FAIL: $*"; echo "$(date +%F) FAIL $*" > "$STATE/status"; notify-send -u critical 'Backup to Google Drive FAILED' "$*" 2>/dev/null; exit 1; }

# Share the coordinator's lock for the whole job, including check and prune.
# Keep the file: unlinking it would let another process lock a different inode.
LOCK_STATE="$HOME/.local/state/rai-maintenance"
mkdir -p "$LOCK_STATE" || fail "cannot create maintenance lock directory"
exec 9>"$LOCK_STATE/.run.lock" || fail "cannot open maintenance lock"
flock 9 || fail "cannot acquire maintenance lock"

: > "$LOG" || fail "cannot open backup log"
log "backup start" || fail "cannot write backup log"
paths=(); for f in "${FOLDERS[@]}"; do [ -d "$HOME/$f" ] && paths+=("$HOME/$f"); done
restic backup "${paths[@]}" --exclude-file="$HOME/.config/restic/excludes.txt" --exclude-caches --tag weekly --tag home-state --one-file-system 2>&1 | tee -a "$LOG" \
  || fail "home backup or logging exited non-zero"

log "machine-state backup" || fail "cannot write backup log"
# restic discards the stream if sudo or tar fails. No plaintext archive is staged.
restic backup --tag weekly --tag machine-state --stdin-filename machine-state.tar --stdin-from-command -- \
  sudo -n /usr/bin/tar --acls --xattrs --one-file-system -C / -cf - etc var/lib/tailscale \
  2>&1 | tee -a "$LOG" || fail "machine-state producer, backup or logging exited non-zero"

# A home snapshot cannot certify the separate privileged stream, or vice versa.
for tag in home-state machine-state; do
  latest=$(restic snapshots --tag "$tag" --latest 1 --json 2>>"$LOG" | uv run --no-project --python 3.12 python -c '
import datetime, json, sys
snapshots = json.load(sys.stdin)
times = [datetime.datetime.fromisoformat(s["time"].replace("Z", "+00:00")) for s in snapshots]
print(max(times).astimezone().date().isoformat() if times else "")
') || fail "cannot read $tag snapshots"
  [ "$latest" = "$(date +%F)" ] || fail "newest $tag snapshot is $latest, expected today"
done

restic check 2>&1 | tee -a "$LOG" || fail "restic check or logging reported errors"

log "forget + prune (keep 4 weekly, 12 monthly, all yearly)" || fail "cannot write backup log"
restic forget --keep-weekly 4 --keep-monthly 12 --keep-yearly unlimited --prune 2>&1 | tee -a "$LOG" \
  || fail "restic forget/prune or logging exited non-zero"

log "backup OK" || fail "cannot write backup log"
echo "$(date +%F) OK" > "$STATE/status" || fail "cannot write backup status"
