# Machine state — created by the theme script, never committed
common/themes/current.lua

# Machine-local secrets (sourced by .zshrc, never committed)
*.local
.zshrc.local

# App secrets / downloaded artifacts (never committed)
.env
*.deb

# macOS noise
.DS_Store

# Python cache (from common/themes/comfort-score.py)
__pycache__/
*.pyc

# Syncthing (~/dev-env is a synced folder since 2026-08-27)
.stfolder/
.stignore
