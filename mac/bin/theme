#!/usr/bin/env bash
# Unified theme switcher: iTerm2, JankyBorders, VS Code, Cursor,
# Starship prompt, macOS appearance, desktop wallpaper.
#
# Usage:
#   theme                         list available themes + current
#   theme <name>                  activate theme
#   theme reload                  re-apply current (used by aerospace on startup)
#   theme cycle                   switch to the next theme in list
#   theme pick                    fzf picker with live preview
#   theme wallpaper [next|prev|random]
#                                 rotate wallpaper within current theme

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
CACHE_DIR="$HOME/.cache/theme"
STARSHIP_CONFIG="$HOME/.config/starship.toml"
BORDERS_BIN="/opt/homebrew/opt/borders/bin/borders"
BORDER_WIDTH=15.0
VSCODE_SETTINGS="$HOME/Library/Application Support/Code/User/settings.json"
CURSOR_SETTINGS="$HOME/Library/Application Support/Cursor/User/settings.json"
OPENCODE_TUI_CONFIG="$HOME/.config/opencode/tui.json"
OPENCODE_THEMES_DIR="$HOME/.config/opencode/themes"
OPENCODE_KV_STATE="$HOME/.local/state/opencode/kv.json"
ITERM2_PROFILE="$HOME/Library/Application Support/iTerm2/DynamicProfiles/rai-theme.json"

mkdir -p "$CACHE_DIR"

SELF="$HOME/.local/bin/theme"
HS_BIN="/opt/homebrew/bin/hs"

hud() {
  local msg="$1" duration="${2:-2}"
  [[ -x "$HS_BIN" ]] || return 0
  # fire-and-forget: a slow/blocked Hammerspoon IPC must never stall the switcher
  ( "$HS_BIN" -c "hs.alert.show(\"$msg\", $duration)" >/dev/null 2>&1 & )
}

# -----------------------------------------------------------------------------
# helpers
# -----------------------------------------------------------------------------

list_themes() {
  for d in "$THEMES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    [[ -f "$d/theme.lua" ]] || continue
    basename "$d"
  done
}

current_theme() {
  if [[ -L "$THEMES_DIR/current.lua" ]]; then
    local target
    target=$(readlink "$THEMES_DIR/current.lua")
    basename "$(dirname "$target")"
  fi
}

theme_wallpapers() {
  local theme="$1"
  find "$THEMES_DIR/$theme/wallpapers" -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null | sort
}

set_wallpaper_on_disk() {
  local wp="$1" theme="$2"
  [[ -z "$wp" || ! -f "$wp" ]] && return 0
  echo "$wp" > "$CACHE_DIR/$theme.wallpaper"
  # macOS Tahoe: legacy System Events 'set picture' sets a path but no longer repaints
  # the live desktop. Render via the compiled NSWorkspace helper (bin/set-wallpaper.swift).
  if [[ -x "$HOME/.local/bin/set-wallpaper" ]]; then
    "$HOME/.local/bin/set-wallpaper" "$wp" 2>/dev/null || true
  fi
}

update_starship_palette() {
  local palette="$1"
  [[ -f "$STARSHIP_CONFIG" ]] || return 0
  if grep -qE '^palette\s*=' "$STARSHIP_CONFIG"; then
    sed -i '' -E "s|^palette[[:space:]]*=.*|palette = \"$palette\"|" "$STARSHIP_CONFIG"
  fi
}

update_vscode_settings() {
  local path="$1" theme="$2"
  [[ -z "$theme" ]] && return 0
  [[ ! -f "$path" ]] && return 0
  python3 - "$path" "$theme" <<'PY'
import re, sys
path, theme = sys.argv[1], sys.argv[2]
c = open(path).read()
pat = r'("workbench\.colorTheme"\s*:\s*)"[^"]*"'
if re.search(pat, c):
    c = re.sub(pat, r'\1"' + theme + '"', c, count=1)
else:
    c = re.sub(r'\{', '{\n  "workbench.colorTheme": "' + theme + '",', c, count=1)
open(path, 'w').write(c)
PY
}

update_opencode_theme() {
  local src="$1" name="$2"
  mkdir -p "$(dirname "$OPENCODE_TUI_CONFIG")" "$OPENCODE_THEMES_DIR" "$(dirname "$OPENCODE_KV_STATE")"
  python3 - "$OPENCODE_TUI_CONFIG" "$OPENCODE_THEMES_DIR" "$OPENCODE_KV_STATE" "$src" "$name" <<'PY'
import json
import re
import sys
from pathlib import Path

tui_path = Path(sys.argv[1])
themes_dir = Path(sys.argv[2])
kv_path = Path(sys.argv[3])
src_path = Path(sys.argv[4])
theme_name = sys.argv[5]

def load_json(path):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

lua = src_path.read_text()

def field(key, default=""):
    match = re.search(rf'{key}\s*=\s*"([^"]+)"', lua)
    return match.group(1) if match else default

def color(key):
    value = field(key)
    if not value:
        return "#000000"
    return "#" + value[-6:] if value.startswith("0xff") else value

def color_list(key):
    match = re.search(rf'{key}\s*=\s*\{{([^}}]+)\}}', lua, re.S)
    if not match:
        return []
    return re.findall(r'"(#[0-9a-fA-F]{6})"', match.group(1))

def mix(c1, c2, t):
    a = tuple(int(c1.lstrip("#")[i:i+2], 16) for i in (0, 2, 4))
    b = tuple(int(c2.lstrip("#")[i:i+2], 16) for i in (0, 2, 4))
    return "#%02x%02x%02x" % tuple(
        max(0, min(255, round(a[i] + (b[i] - a[i]) * t))) for i in range(3)
    )

ansi = color_list("ansi")
bg = color("background")
fg = color("foreground")
red = ansi[1] if len(ansi) > 1 else fg
green = ansi[2] if len(ansi) > 2 else fg
yellow = ansi[3] if len(ansi) > 3 else fg
blue = ansi[4] if len(ansi) > 4 else fg
magenta = ansi[5] if len(ansi) > 5 else fg
cyan = ansi[6] if len(ansi) > 6 else fg

# Omarchy signature colors (bg/fg/ansi accents) stay EXACT. OpenCode also needs
# neutral chrome elevations the 16-color palette doesn't define; derive them by
# blending background -> foreground: dark themes (light fg) step lighter, light
# themes (dark fg) step darker. The loud selection/accent color is reserved for
# the ACTIVE border only -- painting it as a fill was the garish-block bug.
accent = color("border") or blue
panel = mix(bg, fg, 0.06)          # backgroundPanel
element = mix(bg, fg, 0.12)        # backgroundElement: input box, selected rows
border_subtle = mix(bg, fg, 0.14)
border = mix(bg, fg, 0.24)         # default/inactive border (quiet)
muted = mix(bg, fg, 0.55)          # dimmed-but-readable text
diff_add_bg = mix(bg, green, 0.16)
diff_rem_bg = mix(bg, red, 0.16)

theme = {
    "$schema": "https://opencode.ai/theme.json",
    "theme": {
        "primary": accent,
        "secondary": magenta,
        "accent": cyan,
        "error": red,
        "warning": yellow,
        "success": green,
        "info": blue,
        "text": fg,
        "textMuted": muted,
        "background": bg,
        "backgroundPanel": panel,
        "backgroundElement": element,
        "border": border,
        "borderActive": accent,
        "borderSubtle": border_subtle,
        "diffAdded": green,
        "diffRemoved": red,
        "diffContext": muted,
        "diffHunkHeader": blue,
        "diffHighlightAdded": green,
        "diffHighlightRemoved": red,
        "diffAddedBg": diff_add_bg,
        "diffRemovedBg": diff_rem_bg,
        "diffContextBg": panel,
        "diffLineNumber": muted,
        "diffAddedLineNumberBg": diff_add_bg,
        "diffRemovedLineNumberBg": diff_rem_bg,
        "markdownText": fg,
        "markdownHeading": accent,
        "markdownLink": blue,
        "markdownLinkText": cyan,
        "markdownCode": green,
        "markdownBlockQuote": muted,
        "markdownEmph": yellow,
        "markdownStrong": accent,
        "markdownHorizontalRule": muted,
        "markdownListItem": accent,
        "markdownListEnumeration": cyan,
        "markdownImage": magenta,
        "markdownImageText": cyan,
        "markdownCodeBlock": fg,
        "syntaxComment": muted,
        "syntaxKeyword": magenta,
        "syntaxFunction": blue,
        "syntaxVariable": cyan,
        "syntaxString": green,
        "syntaxNumber": yellow,
        "syntaxType": cyan,
        "syntaxOperator": magenta,
        "syntaxPunctuation": fg,
    },
}
(themes_dir / f"{theme_name}.json").write_text(json.dumps(theme, indent=2) + "\n")

tui = load_json(tui_path)
tui.setdefault("$schema", "https://opencode.ai/tui.json")
tui["theme"] = theme_name
tui_path.write_text(json.dumps(tui, indent=2) + "\n")

kv = load_json(kv_path)
kv["theme"] = theme_name
kv_path.write_text(json.dumps(kv, separators=(",", ":")) + "\n")
PY
}

update_iterm2_profile() {
  local src="$1"
  mkdir -p "$(dirname "$ITERM2_PROFILE")"
  python3 - "$src" "$ITERM2_PROFILE" <<'PY'
import json, re, sys
from pathlib import Path

src, dest = Path(sys.argv[1]), Path(sys.argv[2])
lua = src.read_text()

def field(key, default=""):
    m = re.search(rf'{key}\s*=\s*"([^"]+)"', lua)
    return m.group(1) if m else default

def color_list(key):
    m = re.search(rf'{key}\s*=\s*\{{([^}}]+)\}}', lua, re.S)
    return re.findall(r'"(#[0-9a-fA-F]{6})"', m.group(1)) if m else []

def comp(hexstr):
    h = hexstr.lstrip("#")
    r, g, b = (int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))
    return {"Red Component": r, "Green Component": g, "Blue Component": b,
            "Alpha Component": 1, "Color Space": "sRGB"}

colors = {
    "Foreground Color": comp(field("foreground")),
    "Background Color": comp(field("background")),
    "Cursor Color": comp(field("cursor_bg")),
    "Cursor Text Color": comp(field("cursor_fg")),
    "Selection Color": comp(field("selection_bg")),
    "Selected Text Color": comp(field("selection_fg")),
}
for i, c in enumerate(color_list("ansi")[:8]):
    colors[f"Ansi {i} Color"] = comp(c)
for i, c in enumerate(color_list("brights")[:8]):
    colors[f"Ansi {i + 8} Color"] = comp(c)

profile = {
    "Guid": "rai-theme",
    "Name": "rai",
    "Dynamic Profile Rewritable": True,
    "Normal Font": "NotoSansMNF-Bold 16",
    # Arabic: leave this False. Noto Sans Mono has no Arabic coverage, so
    # non-ASCII falls back through CoreText to the system Arabic font, which
    # shapes and joins correctly. Forcing Cairo here was tried 2026-08-14 and
    # made Arabic much worse (letters stopped joining). Do not reopen.
    "Use Non-ASCII Font": False,
    "ASCII Ligatures": False,
    # Readability floor. Every dark theme sets ansi[0] near the background
    # (nord: #3b4252 on #2e3440, ~1.2:1), so anything an app prints in black or
    # faint text becomes unreadable. WezTerm brightened bold ANSI by default;
    # iTerm2 does not, hence the regression after the move.
    #   Minimum Contrast  lifts any fg too close to bg (0 = off, 1 = harsh)
    #   Use Bright Bold   bold+black -> bright black, WezTerm's old behavior
    #   Faint Text Alpha  SGR-2 dim text blend toward bg (iTerm2 default 0.5)
    "Minimum Contrast": 0.5,
    "Use Bright Bold": True,
    "Faint Text Alpha": 0.7,
    "Use Separate Colors for Light and Dark Mode": False,
    "Scrollback Lines": 10000,
    "Unlimited Scrollback": False,
    "Cursor Type": 2,
    "Blinking Cursor": False,
    "Prompt Before Closing 2": 0,
    # No notifications of any kind: no audible bell, no visual flash, no
    # Notification Center alerts.
    "Silence Bell": True,
    "Visual Bell": False,
    "Flashing Bell": False,
    "BM Growl": False,
    "Custom Directory": "No",
    "Keyboard Map": {
        # Shift+Insert paste / Ctrl+Insert copy (PC keyboards send Insert as
        # 0xf727 or Help 0xf746 depending on the keyboard).
        "0xf727-0x20000": {"Action": 25, "Text": "Paste"},
        "0xf746-0x20000": {"Action": 25, "Text": "Paste"},
        "0xf727-0x40000": {"Action": 25, "Text": "Copy"},
        "0xf746-0x40000": {"Action": 25, "Text": "Copy"},
    },
}
profile.update(colors)
dest.write_text(json.dumps({"Profiles": [profile]}, indent=2) + "\n")
PY
}

# -----------------------------------------------------------------------------
# apply a theme end-to-end
# -----------------------------------------------------------------------------

apply_theme() {
  local name="$1"
  local theme_dir="$THEMES_DIR/$name"
  local src="$theme_dir/theme.lua"

  if [[ ! -f "$src" ]]; then
    echo "theme not found: $name" >&2
    return 1
  fi

  get_field() {
    grep -E "^[[:space:]]*$1[[:space:]]*=" "$src" | head -1 | sed -E 's/.*"([^"]*)".*/\1/'
  }

  local border macos vscode_theme cursor_theme
  border=$(get_field border)
  macos=$(get_field macos)
  vscode_theme=$(get_field vscode)
  cursor_theme=$(get_field cursor)

  ln -sfn "$src" "$THEMES_DIR/current.lua"

  # JankyBorders
  [[ -z "$border" ]] && border="0xffd3869b"
  pkill -9 borders 2>/dev/null || true
  sleep 0.3
  LANG="en_US.UTF-8" nohup "$BORDERS_BIN" \
    active_color="$border" \
    inactive_color=0x00000000 \
    width="$BORDER_WIDTH" \
    >/tmp/borders.log 2>&1 & disown

  # iTerm2 watches DynamicProfiles/ and hot-reloads attached sessions.
  update_iterm2_profile "$src"

  # Starship palette
  update_starship_palette "$name"

  # OpenCode: write a matching custom TUI theme from this palette.
  update_opencode_theme "$src" "$name"

  # VS Code + Cursor
  update_vscode_settings "$VSCODE_SETTINGS" "$vscode_theme"
  update_vscode_settings "$CURSOR_SETTINGS" "$cursor_theme"

  # macOS dark/light
  if [[ "$macos" == "dark" ]]; then
    osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true' 2>/dev/null || true
  elif [[ "$macos" == "light" ]]; then
    osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to false' 2>/dev/null || true
  fi

  # Wallpaper: keep last-used for this theme if possible, else first
  local state_file="$CACHE_DIR/$name.wallpaper"
  local wp=""
  if [[ -f "$state_file" ]]; then
    local saved
    saved=$(cat "$state_file")
    [[ -f "$saved" ]] && wp="$saved"
  fi
  if [[ -z "$wp" ]]; then
    wp=$(theme_wallpapers "$name" | head -1)
  fi
  set_wallpaper_on_disk "$wp" "$name"

  hud "$name"

  echo "theme: $name"
  echo "  border:    $border"
  echo "  vscode:    ${vscode_theme:-(skipped)}"
  echo "  cursor:    ${cursor_theme:-(skipped)}"
  echo "  macos:     ${macos:-(unchanged)}"
  echo "  wallpaper: ${wp:-(none)}"
}

# -----------------------------------------------------------------------------
# commands
# -----------------------------------------------------------------------------

cmd="${1:-}"

case "$cmd" in
  "")
    current=$(current_theme || true)
    echo "current: ${current:-(none)}"
    echo "available:"
    list_themes | sed 's/^/  /'
    ;;
  reload)
    name=$(current_theme || true)
    [[ -z "$name" ]] && { echo "no current theme" >&2; exit 1; }
    apply_theme "$name"
    ;;
  regen)
    # Rebuild every OpenCode theme JSON from theme.lua (run after editing the
    # generator). Does NOT switch theme, restart borders, or change wallpaper.
    current=$(current_theme || true)
    while IFS= read -r t; do
      update_opencode_theme "$THEMES_DIR/$t/theme.lua" "$t"
    done < <(list_themes)
    # the loop left tui.json/kv.json on the last theme — restore the active one
    [[ -n "$current" ]] && update_opencode_theme "$THEMES_DIR/$current/theme.lua" "$current"
    echo "regenerated OpenCode themes; active: ${current:-(none)}"
    ;;
  cycle)
    current=$(current_theme || true)
    themes=()
    while IFS= read -r t; do themes+=("$t"); done < <(list_themes)
    idx=0
    for i in "${!themes[@]}"; do
      [[ "${themes[$i]}" == "$current" ]] && { idx=$i; break; }
    done
    next=$(( (idx + 1) % ${#themes[@]} ))
    apply_theme "${themes[$next]}"
    ;;
  pick)
    original=$(current_theme || true)
    if ! selected=$(list_themes | fzf \
          --prompt "theme> " \
          --height 50% \
          --border rounded \
          --preview "cat '$THEMES_DIR/{}/theme.lua'" \
          --preview-window right:45% \
          --bind "focus:execute-silent($SELF {} >/dev/null 2>&1)"); then
      [[ -n "$original" ]] && "$SELF" "$original" >/dev/null
      exit 0
    fi
    echo "theme: $selected"
    ;;
  wallpaper)
    action="${2:-next}"
    current=$(current_theme || true)
    [[ -z "$current" ]] && { echo "no active theme" >&2; exit 1; }
    wps=()
    while IFS= read -r w; do wps+=("$w"); done < <(theme_wallpapers "$current")
    if [[ ${#wps[@]} -eq 0 ]]; then
      echo "no wallpapers for theme: $current" >&2
      exit 0
    fi

    state_file="$CACHE_DIR/$current.wallpaper"
    current_wp=""
    [[ -f "$state_file" ]] && current_wp=$(cat "$state_file")

    idx=0
    for i in "${!wps[@]}"; do
      [[ "${wps[$i]}" == "$current_wp" ]] && { idx=$i; break; }
    done

    case "$action" in
      next)   new_idx=$(( (idx + 1) % ${#wps[@]} )) ;;
      prev)   new_idx=$(( (idx - 1 + ${#wps[@]}) % ${#wps[@]} )) ;;
      random) new_idx=$(( RANDOM % ${#wps[@]} )) ;;
      *) echo "usage: theme wallpaper [next|prev|random]" >&2; exit 1 ;;
    esac

    new_wp="${wps[$new_idx]}"
    set_wallpaper_on_disk "$new_wp" "$current"
    wp_name=$(basename "$new_wp")
    hud "$wp_name  ($((new_idx + 1))/${#wps[@]})"
    echo "wallpaper: $wp_name  ($((new_idx + 1))/${#wps[@]})"
    ;;
  *)
    apply_theme "$cmd"
    ;;
esac
