#!/usr/bin/env bash
# Theme switcher on Omarchy 4: a thin wrapper over `omarchy theme`, keeping the
# same verbs the Ubuntu box had. Colors come from ~/.config/themes/<name>/theme.lua,
# rendered into ~/.config/omarchy/themes/<name>/ by `theme render` (theme-render).
# Post-switch extras (tmux bar, starship palette, current.lua pointer) run from
# ~/.config/omarchy/hooks/theme-set.d/rai-theme-set.
#
#   theme                  current + list         theme cycle          next theme
#   theme <name>           switch                 theme pick           fzf picker
#   theme reload           re-apply current       theme menu           Omarchy theme menu
#   theme wallpaper next   next background        theme wallpaper menu background menu
#   theme render [name]    rebuild Omarchy themes from theme.lua
set -euo pipefail
THEMES_DIR="$HOME/.config/themes"

list_themes() { find "$THEMES_DIR" -mindepth 2 -maxdepth 2 -name theme.lua -printf '%h\n' | xargs -n1 basename | sort; }
current_theme() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo ""; }

case "${1:-}" in
  "")            cur=$(current_theme); for t in $(list_themes); do [[ "$t" == "$cur" ]] && echo "* $t" || echo "  $t"; done ;;
  reload)        omarchy-theme-set "$(current_theme)" ;;
  cycle)         mapfile -t all < <(list_themes); cur=$(current_theme); next="${all[0]}"
                 for i in "${!all[@]}"; do [[ "${all[$i]}" == "$cur" ]] && next="${all[$(( (i+1) % ${#all[@]} ))]}"; done
                 omarchy-theme-set "$next" ;;
  pick)          sel=$(list_themes | fzf --prompt='theme> ' --height=40% --reverse) && omarchy-theme-set "$sel" ;;
  menu)          omarchy-menu toggle theme ;;
  wallpaper)     case "${2:-next}" in next) omarchy-theme-bg-next ;; menu) omarchy-menu toggle background ;; *) echo "theme wallpaper next|menu"; exit 1 ;; esac ;;
  render)        shift; "$HOME/.local/bin/theme-render" "$@" ;;
  -h|--help)     sed -n '2,13p' "$0" ;;
  *)             [[ -f "$THEMES_DIR/$1/theme.lua" ]] || { echo "unknown theme: $1"; exit 1; }
                 [[ -f "$HOME/.config/omarchy/themes/$1/colors.toml" ]] || "$HOME/.local/bin/theme-render" "$1"
                 omarchy-theme-set "$1" ;;
esac
